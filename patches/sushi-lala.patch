diff --git a/src/exl3_ubench/lala.zig b/src/exl3_ubench/lala.zig
new file mode 100644
index 00000000..59b70216
--- /dev/null
+++ b/src/exl3_ubench/lala.zig
@@ -0,0 +1,193 @@
+//! Verify grouped Metal projection on native bytes from Lala layer 44.
+const std = @import("std");
+const mlx = @import("mlx_host").mlx;
+const report = @import("mlx_host").report;
+const api = @import("sushi_exl3");
+const bench = @import("bench_util.zig");
+
+const hidden = 4096;
+const clamp = 10;
+const group_count = 4;
+const max_rows = 16;
+const max_topk = 8;
+
+pub const fixture: report.Bench = .{
+    .name = "shared.lala_layer44",
+    .scope = .shared,
+    .what = "Lala layer 44 prepared kernels with different weight orders and expert group sizes",
+    .steps = 16,
+    .axes = &.{
+        .{ .name = "rows", .values = &.{ "1", "4", "8", "16" } },
+        .{ .name = "topk", .values = &.{ "1", "8" } },
+    },
+    .arms = &.{ "uniform", "grouped", "prepared", "prefill", "tile-major", "group-four", "group-eight" },
+    .ref = "prepared",
+    .run = runFixture,
+};
+
+fn weight(a: std.mem.Allocator, map: mlx.mlx_map_string_to_array, group: usize, projection: []const u8, part: []const u8) !mlx.mlx_array {
+    const key = try std.fmt.allocPrintSentinel(a, "model.language_model.layers.44.mlp.switch_mlp.{s}.g{d}.{s}", .{ projection, group, part }, 0);
+    defer a.free(key);
+    var array = mlx.mlx_array_new();
+    errdefer _ = mlx.mlx_array_free(array);
+    try mlx.check(mlx.mlx_map_string_to_array_get(&array, map, key.ptr));
+    return array;
+}
+
+fn readBank(a: std.mem.Allocator, map: mlx.mlx_map_string_to_array, group: usize) !api.Bank {
+    var bank: api.Bank = std.mem.zeroes(api.Bank);
+    errdefer bench.freeBank(&bank);
+    for ([_][]const u8{ "gate_proj", "up_proj", "down_proj" }, [_]*api.Proj{ &bank.gate, &bank.up, &bank.down }) |projection, proj| {
+        proj.trellis = try weight(a, map, group, projection, "trellis");
+        proj.suh = try weight(a, map, group, projection, "suh");
+        proj.svh = try weight(a, map, group, projection, "svh");
+    }
+    return bank;
+}
+
+const Trial = struct {
+    bank: api.Bank,
+    ragged: *const api.Ragged,
+    tile_major: *const api.Ragged,
+    s: mlx.mlx_stream,
+    x: mlx.mlx_array,
+    x3: mlx.mlx_array,
+    ids: mlx.mlx_array,
+    ids3: mlx.mlx_array,
+    scores: mlx.mlx_array,
+    scores3: mlx.mlx_array,
+    rows: c_int,
+    topk: c_int,
+    steps: usize,
+
+    fn forward(self: Trial, arm: usize) !mlx.mlx_array {
+        if (arm == 0) {
+            if (self.topk != 1) return error.LalaUniformTopKUnsupported;
+            return api.moeClamped(self.s, self.x3, self.bank, self.ids3, self.scores3, .mul1, clamp);
+        }
+        if (arm == 3) return api.rate_groups.moePrefillClamped(self.s, self.x, self.ragged, self.ids, self.scores, self.topk, clamp);
+        const old = api.rate_groups.prepared_force;
+        const old_group = api.rate_groups.group_force;
+        defer api.rate_groups.prepared_force = old;
+        defer api.rate_groups.group_force = old_group;
+        api.rate_groups.prepared_force = arm == 2 or arm >= 4;
+        switch (arm) {
+            5 => api.rate_groups.group_force = 4,
+            6 => api.rate_groups.group_force = 8,
+            else => {},
+        }
+        const bank = if (arm == 4) self.tile_major else self.ragged;
+        return api.rate_groups.moeDecodeClamped(self.s, self.x, bank, self.ids, self.scores, self.topk, .bfloat16, null, null, clamp);
+    }
+};
+
+fn elapsed(self: Trial, arm: usize) anyerror!f64 {
+    const Context = struct {
+        trial: Trial,
+        arm: usize,
+
+        fn step(ctx: @This(), s: mlx.mlx_stream, _: usize, input: mlx.mlx_array) anyerror!mlx.mlx_array {
+            var next = ctx.trial;
+            next.s = s;
+            next.x = input;
+            next.x3 = try api.rate_groups.reshaped(s, input, &.{ 1, next.rows, hidden });
+            defer _ = mlx.mlx_array_free(next.x3);
+            const result = try next.forward(ctx.arm);
+            defer _ = mlx.mlx_array_free(result);
+            return api.rate_groups.reshaped(s, result, &.{ next.rows, hidden });
+        }
+    };
+    const ns = try bench.chainNs(self.s, self.x, self.steps, Context{ .trial = self, .arm = arm }, Context.step);
+    return @as(f64, @floatFromInt(ns)) / @as(f64, @floatFromInt(self.steps));
+}
+
+fn compare(trial: Trial, run: *report.Run, arm: usize, arm_name: []const u8, want: []const f32) !void {
+    const candidate = try trial.forward(arm);
+    defer _ = mlx.mlx_array_free(candidate);
+    var rhs = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(rhs);
+    const got = try api.f32_truth.toF32(trial.s, candidate, &rhs);
+    if (want.len != got.len) return error.LalaShapeMismatch;
+    var mismatches: usize = 0;
+    var error2: f64 = 0;
+    var norm2: f64 = 0;
+    for (want, got) |w, g| {
+        if (!std.math.isFinite(w) or !std.math.isFinite(g)) return error.LalaNonFinite;
+        mismatches += @intFromBool(w != g);
+        const delta = @as(f64, w) - @as(f64, g);
+        error2 += delta * delta;
+        norm2 += @as(f64, w) * @as(f64, w);
+    }
+    try run.metric(arm_name, "relative RMS", "fraction", @sqrt(error2 / @max(norm2, 1e-30)));
+    try run.metric(arm_name, "different values", "values", @floatFromInt(mismatches));
+}
+
+fn runFixture(run: *report.Run) anyerror!void {
+    const a = run.a;
+    const directory = run.pack orelse return error.LalaFixtureRequired;
+    const path = try std.fmt.allocPrintSentinel(a, "{s}/layer44-sample.safetensors", .{directory}, 0);
+    var map = mlx.mlx_map_string_to_array_new();
+    defer _ = mlx.mlx_map_string_to_array_free(map);
+    var metadata = mlx.mlx_map_string_to_string_new();
+    defer _ = mlx.mlx_map_string_to_string_free(metadata);
+    try mlx.check(mlx.mlx_load_safetensors(&map, &metadata, path.ptr, mlx.mlx_default_cpu_stream_new()));
+    var banks: [group_count]api.Bank = undefined;
+    var loaded: usize = 0;
+    defer for (banks[0..loaded]) |*bank| bench.freeBank(bank);
+    while (loaded < banks.len) : (loaded += 1) banks[loaded] = try readBank(a, map, loaded);
+
+    const s = mlx.gpuStream();
+    api.kernels.setDecodeParams(.mul1);
+    var grouped = try api.Ragged.init(s, &banks);
+    defer grouped.deinit();
+    var tile_major = try api.rate_groups.tileMajorCopy(s, &grouped);
+    defer tile_major.deinit();
+    var experts: usize = 0;
+    for (banks) |bank| experts += @intCast(mlx.getShape(bank.gate.suh)[0]);
+    var prng = std.Random.DefaultPrng.init(608665);
+    for (run.axis("rows")) |rows_text| for (run.axis("topk")) |topk_text| {
+        const rows = try std.fmt.parseInt(c_int, rows_text, 10);
+        const topk = try std.fmt.parseInt(c_int, topk_text, 10);
+        const slots: usize = @intCast(rows * topk);
+        if (experts < @as(usize, @intCast(topk))) return error.LalaInsufficientExperts;
+        const acts = try api.f32_truth.activations(a, prng.random(), @intCast(rows), hidden, 1);
+        defer _ = mlx.mlx_array_free(acts.x);
+        const x3 = try api.rate_groups.reshaped(s, acts.x, &.{ 1, rows, hidden });
+        defer _ = mlx.mlx_array_free(x3);
+        var scales: [max_rows * max_topk]f32 = undefined;
+        for (scales[0..slots], 0..) |*scale, i| {
+            const rank: c_int = @intCast(i % @as(usize, @intCast(topk)));
+            scale.* = @as(f32, @floatFromInt(topk - rank)) / @as(f32, @floatFromInt(@divExact(topk * (topk + 1), 2)));
+        }
+        const zeros: [max_rows * max_topk]u32 = @splat(0);
+        const scores = mlx.mlx_array_new_data(&scales, &.{rows * topk}, 1, .float32);
+        defer _ = mlx.mlx_array_free(scores);
+        const scores3 = try api.rate_groups.reshaped(s, scores, &.{ 1, rows, topk });
+        defer _ = mlx.mlx_array_free(scores3);
+        const ids3 = mlx.mlx_array_new_data(&zeros, &.{ 1, rows, topk }, 3, .uint32);
+        defer _ = mlx.mlx_array_free(ids3);
+        for (&banks, 0..) |bank, group| {
+            var route: [max_rows * max_topk]u32 = undefined;
+            const count: usize = @intCast(topk);
+            for (route[0..slots], 0..) |*id, slot| {
+                const expert = if (topk == 1) group else (group * 7 + (slot / count) * 5 + slot % count) % experts;
+                id.* = @intCast(expert);
+            }
+            const ids = mlx.mlx_array_new_data(&route, &.{rows * topk}, 1, .uint32);
+            defer _ = mlx.mlx_array_free(ids);
+            const trial = Trial{ .bank = bank, .ragged = &grouped, .tile_major = &tile_major, .s = s, .x = acts.x, .x3 = x3, .ids = ids, .ids3 = ids3, .scores = scores, .scores3 = scores3, .rows = rows, .topk = topk, .steps = run.steps(16) };
+            const baseline = try trial.forward(2);
+            defer _ = mlx.mlx_array_free(baseline);
+            var lhs = mlx.mlx_array_new();
+            defer _ = mlx.mlx_array_free(lhs);
+            const want = try api.f32_truth.toF32(s, baseline, &lhs);
+            const label = try std.fmt.allocPrint(a, "rows={d} topk={d} route={d}", .{ rows, topk, group });
+            try run.interleave(label, trial, elapsed);
+            try compare(trial, run, 1, "grouped", want);
+            try compare(trial, run, 3, "prefill", want);
+            try compare(trial, run, 4, "tile-major", want);
+            try compare(trial, run, 5, "group-four", want);
+            try compare(trial, run, 6, "group-eight", want);
+        }
+    };
+}
